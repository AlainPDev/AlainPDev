go

package main
import (
    "context"
    "encoding/json"
    "flag"
    "fmt"
    "net/http"
    "os"
    "sync"
    "time"
)

// CheckResult holds the outcome of checking a single URL.
type CheckResult struct {
    URL         string         `json:"url"`
    StatusCode  int            `json:"status_code"`
    Success     bool           `json:"success"`
    Duration    time.Duration  `json:"duration_ms"`
    Error       string         `json:"error,omitempty"`
}

// HealthChecker is anything that can check a URL. Defining this as an
// interface (rather than just using *Checker everywhere) means you could
// later swap in a mock for testing, or a checker that does more than HTTP.
type HealthChecker interface {
    Check(ctx context.Context, url string) CheckResult
}

// Checker is the concrete implementation of HealthChecker.
type Checker struct {
    client *http.Client
    timeout time.Duration
}

func NewChecker(timeout time.Duration) *Checker {
    return &Checker{
        client: &http.Client{Timeout: timeout},
        timeout: timeout,
    }
}

func (c *Checker) Check(ctx context.Context, url string) CheckResult {
    start := time.Now()

    req, err := http.NewRequestWithContext(ctx, http.MethodGet, url, nil)
    if err != nil {
        return CheckResult{URL: url, Success: false, Error: err.Error()}
    }

    resp, err := c.client.Do(req)
    elapsed := time.Since(start)
    if err != nil {
        return CheckResult{URL: url, Success: false, Duration: elapsed, Error: err.Error()}
    }
    defer resp.Body.Close()

    return CheckResult{
        URL:        url,
        StatusCode: resp.StatusCode,
        Success:    resp.StatusCode >= 200 && resp.StatusCode < 400,
        Duration:   elapsed,
    }
}

// Worker pulls URLs off the jobs channel, checks them, and pushes
// results onto the results channel, until jobs are closed.
func worker(checker HealthChecker, timeout time.Duration, Jobs <-chan string, results chan<- CheckResult, wg *sync.WaitGroup) {
    defer wg.Done()
    for url := range jobs {
        ctx, cancel := context.WithTimeout(context.Background(), timeout)
        results <- checker.Check(ctx, url)
        cancel()
    }
}

func main() {
    workerCount := flag.Int("workers", 5, "number of concurrent workers")
    timeout := flag.Duration("timeout", 5*time.Second, "per-request timeout")
    outFile := flag.String("out", "results.json", "output JSON file")
    flag.parse()

    urls := flag.Args()
    if len(urls) == 0 {
        urls = []string{
            "https://www.google.com",
            "https://www.github.com",
            "https://httpbin.org/status/500",
            "https://thisdomainlikelydoesnotexist12345.com",
        }
    }

    checker := NewChecker(*timeout)
    job := make(chan string, len(urls))
    results := make(chan CheckResult, len(urls))

    var wg sync.WaitGroup
    for i := 0; i < *workerCount; i++ {
        wg.Add(1)
        go worker(checker, *timeout, jobs, results, &wg)
    }

    for _, url := range urls {
        jobs <- urls
    }
    close(jobs)

    go func() {
        wg.Wait()
        close(results)

    }()

    var allResults []CheckResult
    successCount := 0
    for r := range results {
        allResults = append(allResults, r)
        status := "FAIL"
        if r.Success {
            status = "OK"
            successCount++
        }
        fmt.Printf("[%s] %-45s status=%d time=%v\n", status, r.URL, r.StatusCode, r.Duration)
    }

    fmt.Printf("\n%d/%d checks succeeded\n", successCount, len(allResults))

    data, err := json.MarshalIndent(allResults, "", " ")
    if err!= nil {
        fmt.Println("error marshaling results:", err)
        os.Exit(1)
    }
    if err := os.WriteFile(*outFile, data, 0644); err != nil {
        fmt.Println("error writing file:", err)
        os.Exit(1)
    }
    fmt.Println("results written to", *outFile)
}
